# AMERCK CARE Environment Configuration Template
# Duplicate this file as .env and replace the values with your credentials

BASE_URL=https://qa_care.amerck.com
API_BASE_URL=https://api_emr_dev.amerck.com

# QA Test Credentials
QA_USERNAME=your_username
QA_PASSWORD=your_password

# EMR-236 role accounts (tests/emr-236.spec.js)
# Each role test checks after login that the account fits its role, and skips with the reason if it doesn't.
# Another doctor WITH "Aesthetic Consultations" (must have finished onboarding)
EMR236_DRK_USERNAME=another_doctor_username
EMR236_DRK_PASSWORD=another_doctor_password
# A doctor WITHOUT "Aesthetic Consultations" (clinical user with role "Default" only)
EMR236_NOPERM_USERNAME=doctor_without_consultations_username
EMR236_NOPERM_PASSWORD=doctor_without_consultations_password
# Front desk: NOT a doctor, WITH "Aesthetic Consultations" (non-clinical user with role "Doctor")
EMR236_FRONTDESK_USERNAME=front_desk_username
EMR236_FRONTDESK_PASSWORD=front_desk_password
# Cashier: a user WITHOUT "Aesthetic Consultations"
EMR236_CASHIER_USERNAME=cashier_username
EMR236_CASHIER_PASSWORD=cashier_password

# Optional: skip the tests that create QA data
# EMR236_READONLY=1
# EMR237_READONLY=1
