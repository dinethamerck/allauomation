# ===================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# Never commit the actual .env file.
# ===================================================================

QA_CARE_BASE_URL=https://qa_care.amerck.com
QA_CARE_PRESCRIPTION_URL=https://qa_care.amerck.com/admin/prescription

# QA Care Portal Credentials (Replace with your testing credentials)
QA_CARE_USERNAME=your_username_here
QA_CARE_PASSWORD=your_password_here

# Test Execution Settings
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=30000
